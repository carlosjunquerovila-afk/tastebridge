+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {readFile} from 'node:fs/promises';
+// The optional path makes the same assertions reproducible against an archived
+// baseline; normal test runs always use the current production implementation.
+const {rankGroup}=await import(process.env.TASTEBRIDGE_RANK_SOURCE||'./lib/taste.ts');
+
+const ids=['a','b','c','d'];
+const rows=profiles=>profiles.map(p=>Object.fromEntries(ids.map((id,i)=>[id,p[i]])));
+const counterexample=rows([[0,1,2,3],[0,1,2,3],[0,2,1,3],[3,2,1,0]]);
+const tied=ranking=>ranking.filter(r=>r.minimum===ranking[0].minimum&&r.mean===ranking[0].mean).map(r=>r.id);
+function* permutations(values){
+ if(!values.length){yield [];return;}
+ for(let i=0;i<values.length;i++)for(const rest of permutations(values.filter((_,j)=>i!==j)))yield [values[i],...rest];
+}
+
+test('an exact mathematical tie must not become a unique recommendation',()=>{
+ const ranking=rankGroup(counterexample,ids);
+ assert.deepEqual(tied(ranking),['b','c']);
+ assert.equal(ranking[0].mean,.5);
+ assert.equal(ranking[1].mean,.5);
+});
+
+test('every guest order preserves the entire decision in the regression case',()=>{
+ const expected=rankGroup(counterexample,ids).map(({ranks,...decision})=>decision);
+ for(const order of permutations(counterexample)){
+  assert.deepEqual(rankGroup(order,ids).map(({ranks,...decision})=>decision),expected);
+ }
+});
+
+test('every candidate order preserves the tied shortlist',()=>{
+ for(const order of permutations(ids))assert.deepEqual(tied(rankGroup(counterexample,order)),['b','c']);
+});
+
+test('the recorded Qloo replay still exposes both tied places without a provider call',async()=>{
+ const recorded=JSON.parse(await readFile(new URL('./lib/verified-case.json',import.meta.url),'utf8'));
+ const options=recorded.places.map(p=>p.id).sort();
+ assert.deepEqual(tied(rankGroup(recorded.guests.map(g=>g.affinities),options)),options);
+});
+
+test('deterministic profiles with ties match an integer rank oracle for 2–6 guests and 2–5 places',()=>{
+ let state=20261026;
+ const rand=()=>{state=(Math.imul(state,1664525)+1013904223)>>>0;return state;};
+ for(let count=2;count<=5;count++)for(let guests=2;guests<=6;guests++)for(let sample=0;sample<250;sample++){
+  const options=Array.from({length:count},(_,i)=>String.fromCharCode(97+i));
+  const matrix=Array.from({length:guests},()=>{
+   const values=options.map(()=>rand()%7);
+   if(new Set(values).size===1)values[0]++;
+   return Object.fromEntries(options.map((id,i)=>[id,values[i]]));
+  });
+  // Count pairwise wins (2 units) and ties (1 unit), excluding self.
+  // Compare these exact integers before any normalization.
+  const expected=options.map(id=>{
+   const units=matrix.map(m=>options.reduce((sum,other)=>sum+(other===id?0:m[id]>m[other]?2:m[id]===m[other]?1:0),0));
+   return {id,min:Math.min(...units),sum:units.reduce((a,b)=>a+b,0)};
+  }).sort((a,b)=>b.min-a.min||b.sum-a.sum||a.id.localeCompare(b.id));
+  const actual=rankGroup(matrix,options);
+  assert.deepEqual(actual.map(r=>r.id),expected.map(r=>r.id));
+  assert.deepEqual(tied(actual),expected.filter(r=>r.min===expected[0].min&&r.sum===expected[0].sum).map(r=>r.id));
+  assert.deepEqual(actual.map(({ranks,...decision})=>decision),rankGroup([...matrix].reverse(),options).map(({ranks,...decision})=>decision));
+ }
+});
